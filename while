while.l

%{
#include "y.tab.h"
%}
%%
"while"                       { return WHILE; }
[a-zA-Z_][a-zA-Z0-9_]*        { return ID; }
[0-9]+                        { return NUM; }
"=="|"!="|"<="|">="|"<"|">"   { return RELOP; }
[ \t\r\n]                     ;
.                             { return yytext[0]; }
%%
int yywrap() { return 1; }


whil.y

%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%token WHILE ID NUM RELOP

%%
S : while_stmt
  ;

while_stmt : WHILE '(' cond ')' block
           ;

cond : operand RELOP operand
     ;

operand : ID
        | NUM
        ;

block : '{' stmts '}'
      ;

stmts : stmts simple
      |
      ;

simple : ID '=' expr ';'
       | while_stmt
       ;

expr : operand
     | operand '+' operand
     | operand '-' operand
     | operand '*' operand
     | operand '/' operand
     ;
%%

int main() {
    printf("Enter the while statement (end with Ctrl+D):\n");
    if (yyparse() == 0)
        printf("valid case\n");
    return 0;
}

void yyerror(const char *s) {
    printf("syntax error\n");
}
