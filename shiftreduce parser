#include<stdio.h>
#include<stdlib.h>
#include<string.h>

char stack[50] , input[50];
int i =0 , top = 0;

void check(){
	int reduced = 1;
	while(reduced){
		reduced =0;
		if(top >=2 && stack[top -1] == 'i'){
			stack[top-1]  = 'E';
			printf("%-15s %-15s reduce E->i\n",stack , &input[i]);
			reduced = 1;
		}
		else if(top >= 2 && stack[top -3] =='E' && stack[top-2] =='*' &&stack[top-1]=='E'){
			stack[top-3] = 'E';
			top -=2;
			stack[top] = '\0';
			printf("%-15s %-15s reduce E->E*E\n",stack , &input[i]);
			reduced = 1;
		}
		else if(top >= 2 && stack[top -3] =='E' && stack[top-2] =='+' &&stack[top-1]=='E'){
			if(input[i] == '*')
			{
				break;
			}
			stack[top-3] = 'E';
			top -=2;
			stack[top] = '\0';
			printf("%-15s %-15s reduce E->E+E\n",stack , &input[i]);
			reduced = 1;
		}
	}
}

int main(){
	printf("enter the input string with $at the end:");
	scanf("%s",input);
	
	stack[top] = '$';
	stack[top+1] = '\0';
	top = 1;
	
	while(i < strlen(input) -1){
		stack[top] = input[i];
		stack[top+1] = '\0';
		top++;
		
		printf("%-15s %-15s shift\n" , stack , &input[i]);
		i++;
		check();
		
	}
	if (stack[1] == 'E' && stack[2] =='\0' && input[i] == '$'){
		printf("%-15s %-15s accepted\n" , stack , "$");
	}
	else{
		printf("%-15s %-15s error rejected\n" , stack , &input[i]);
	}
	
	return 0;
}



