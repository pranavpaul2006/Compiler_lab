cal.l(LEX)

%{
	#include<stdio.h>
	#include"y.tab.h"
%}

%%
[0-9]+ {yylval = atoi(yytext); return NUMBER;}
[ \t] ;
\n {return 0;}
. {return yytext[0];}	
%%

int yywrap(){
	return 1;
}


cal.y(YACC)

%{
	#include<stdio.h>
	int yylex(void);
	void yyerror(const char *s);
%}

%token NUMBER
%left '+' '-';
%left '*' '/';

%%
S : E	{printf("result = %d\n",$1);}
  ;
  
E : E '+' E	{$$ = $1 + $3;}
  | E '-' E	{$$ = $1 - $3;}
  | E '*' E	{$$ = $1 * $3;}
  | E '/' E	{$$ = $1 / $3;}
  | '('E')'	{$$ = $2;}
  |NUMBER	{$$= $1;}
  ;
%%

int main(){
	printf("Enter expression:\n");
	yyparse();
	return 0;
}

void yyerror(const char *s){
	printf("errors: %s\n",s);
}



