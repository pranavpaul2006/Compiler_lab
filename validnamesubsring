%{
#include <stdio.h>
%}

%%
.*[jJ][oO][hH][nN].*    { printf("REJECTED : \"%s\" contains john\n", yytext); }
[^\n]+                  { printf("ACCEPTED : \"%s\" does not contain john\n", yytext); }
\n                      ;
%%

int main() {
    printf("Name: johnny, substring to avoid: john (any case)\n");
    printf("Enter strings, one per line (end with Ctrl+D):\n");
    yylex();
    return 0;
}

int yywrap() {
    return 1;
}




%{
#include <stdio.h>
#include <string.h>
char key[5];
%}

%%
[^\n]+    {
              if (strstr(yytext, key) == NULL)
                  printf("ACCEPTED : \"%s\" does not contain \"%s\"\n", yytext, key);
              else
                  printf("REJECTED : \"%s\" contains \"%s\"\n", yytext, key);
          }
\n        ;
%%

int main() {
    char name[50];

    printf("Enter your name: ");
    scanf("%49s", name);

    if (strlen(name) < 4) {
        printf("Name must have at least 4 characters\n");
        return 1;
    }

    strncpy(key, name, 4);
    key[4] = '\0';

    printf("Substring to avoid: %s\n", key);
    printf("Enter strings, one per line (end with Ctrl+D):\n");

    yylex();
    return 0;
}

int yywrap() {
    return 1;
}
