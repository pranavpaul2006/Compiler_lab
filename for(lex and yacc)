for.l 

%{
#include "y.tab.h"
%}
%%
"for"                         { return FOR; }
[a-zA-Z_][a-zA-Z0-9_]*        { return ID; }
[0-9]+                        { return NUM; }
"++"                          { return INC; }
"--"                          { return DEC; }
"=="|"!="|"<="|">="|"<"|">"   { return RELOP; }
[ \t\r\n]                     ;
.                             { return yytext[0]; }
%%
int yywrap() { return 1; }


for.y

%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%token FOR ID NUM RELOP INC DEC

%%
S : for_stmt
  ;

for_stmt : FOR '(' assign ';' cond ';' update ')' block
         ;

assign : ID '=' expr
       ;

update : ID '=' expr
       | ID INC
       | ID DEC
       ;

cond : operand RELOP operand
     ;

expr : operand
     | operand '+' operand
     | operand '-' operand
     | operand '*' operand
     | operand '/' operand
     ;

operand : ID
        | NUM
        ;

block : '{' stmts '}'
      ;

stmts : stmts simple
      |
      ;

simple : ID '=' expr ';'
       | for_stmt
       ;
%%

int main() {
    printf("Enter the for statement (end with Ctrl+D):\n");
    if (yyparse() == 0)
        printf("valid case\n");
    return 0;
}

void yyerror(const char *s) {
    printf("syntax error\n");
}
