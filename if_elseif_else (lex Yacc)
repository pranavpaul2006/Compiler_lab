int yywrap(){
	return 1;
}

if.y(YACC)

%{
	#include<stdio.h>
	int yylex(void);
	void yyerror(const char *s);
%}

%token IF RELOP ELSEIF ELSE ID NUM

%%
S : ifblock
  ;
  
ifblock : IF '(' condition ')' stmtblock elseifblock elseblock
	;
elseifblock : ELSEIF '(' condition ')' stmtblock elseifblock
	    |
	    ;
elseblock : ELSE stmtblock
	  | 
	  ;
condition : operand RELOP operand
	  ;
operand : ID 
	| NUM
	;
stmtblock : '{' block '}'
	  ;
block : block simplestmt
      |
      ;
simplestmt : ID '=' operand ';'
      | ifblock
      ;    
%%

